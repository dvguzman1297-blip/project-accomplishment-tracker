NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Registration (server-only; never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GMAIL_USER=your.account@gmail.com
# Google Account > Security > 2-Step Verification > App passwords (16 characters, no spaces)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Optional: comma-separated email domains allowed to register (empty = anyone)
REGISTER_ALLOWED_DOMAINS=

# As-Built reminder emails: schedule GET /api/cron/notifications daily with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=generate-a-long-random-string
NOTIFY_EMAILS=engineer@example.com,inspector@example.com
